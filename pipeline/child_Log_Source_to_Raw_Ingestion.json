{
	"name": "child_Log_Source_to_Raw_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "Log_Batch_Details",
				"description": "This activity will perform the Logs start of batch ingestion into metadata.BatchMaster by calling [metadata].[usp_StartBatch]",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[metadata].[usp_StartBatch]",
					"storedProcedureParameters": {
						"ApplicationName": {
							"value": {
								"value": "@pipeline().parameters.p_ApplicationName",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchID": {
							"type": "String"
						},
						"LoadGroupName": {
							"value": {
								"value": "@pipeline().parameters.p_LoadGroupName",
								"type": "Expression"
							},
							"type": "String"
						},
						"SourceSystemName": {
							"value": {
								"value": "@pipeline().parameters.p_SourceSystemName",
								"type": "Expression"
							},
							"type": "String"
						},
						"StageName": {
							"value": {
								"value": "@pipeline().parameters.p_StageName",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_sqldb_metadata",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"p_ApplicationName": {
				"type": "string"
			},
			"p_SourceSystemName": {
				"type": "string"
			},
			"p_LoadGroupName": {
				"type": "string"
			},
			"p_StageName": {
				"type": "string"
			},
			"childBatchID": {
				"type": "string"
			}
		},
		"annotations": []
	}
}